---
import ThemeIcon from '@components/ThemeIcon.astro';
import NavLink from '@components/ui/links/NavLink.astro';
import Authentication from '../misc/Authentication.astro';
import BrandLogo from '@components/BrandLogo.astro';
import LanguagePicker from '@components/ui/LanguagePicker.astro';
import NavbarToggle from '@components/ui/buttons/NavbarToggle.astro';
import { navLinks } from '@data/navigation';
import { localePath } from '@utils/locale';

const { locale, copy: t } = Astro.locals;

/**
 * 作品集页顶部是深墨绿（#17231f）Hero 大图。导航若沿用浅色毛玻璃，
 * 会像一块浅色条压住大图、Logo 也失去对比。这里按路由切换成深色玻璃。
 */
const isDarkHeroPage = /^\/(zh\/)?portfolio\/?$/.test(Astro.url.pathname);
---

{/* Main header component */}
<header
  class="sticky inset-x-0 top-4 z-50 flex w-full flex-wrap text-sm md:flex-nowrap md:justify-start"
  data-navbar-tone={isDarkHeroPage ? 'on-dark' : undefined}
>
  {/* Navigation container */}
  <nav
    class="relative mx-2 w-[calc(100%-1rem)] rounded-[36px] border border-yellow-100/40 bg-yellow-50/60 px-4 py-3 backdrop-blur-md md:flex md:items-center md:justify-between md:px-6 md:py-0 lg:px-8 xl:mx-auto dark:border-neutral-700/40 dark:bg-neutral-800/80 dark:backdrop-blur-md"
    aria-label="Global"
  >
    <div class="flex items-center justify-between">
      {/* Brand logo */}
      <a
        class="flex-none rounded-lg text-xl font-bold ring-zinc-500 outline-hidden focus-visible:ring-3 dark:ring-zinc-200 dark:focus:outline-hidden"
        href={localePath(locale)}
        aria-label="XMore Studio"
      >
        <BrandLogo class="h-auto w-24" />
      </a>
      <NavbarToggle target="navbar-collapse-with-animation" />
      {/* ThemeIcon component specifically for smaller screens */}
      <span class="inline-block md:hidden">
        <ThemeIcon />
      </span>
    </div>
    {/* Contains navigation links */}
    <div
      id="navbar-collapse-with-animation"
      class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 md:block"
    >
      {/* Navigation links container */}
      <div class="mt-5 flex flex-col gap-x-0 gap-y-4 md:mt-0 md:flex-row md:items-center md:justify-end md:gap-x-4 md:gap-y-0 md:ps-7 lg:gap-x-7">
        {/* Navigation links and Authentication component */}
        {navLinks.map(link => (
          <NavLink
            url={localePath(locale, link.path)}
            name={t.nav.labels[link.id]}
          />
        ))}

        <Authentication />
        <LanguagePicker />
        {/* ThemeIcon component specifically for larger screens */}
        <span class="hidden md:inline-block">
          <ThemeIcon />
        </span>
      </div>
    </div>
  </nav>
</header>
{/* Theme Appearance script to manage light/dark modes */}
<script is:inline>
  const HSThemeAppearance = {
    init() {
      const defaultTheme = 'default';
      let theme = localStorage.getItem('hs_theme') || defaultTheme;

      if (document.querySelector('html').classList.contains('dark')) return;
      this.setAppearance(theme);
    },
    _resetStylesOnLoad() {
      const $resetStyles = document.createElement('style');
      $resetStyles.innerText = `*{transition: unset !important;}`;
      $resetStyles.setAttribute('data-hs-appearance-onload-styles', '');
      document.head.appendChild($resetStyles);
      return $resetStyles;
    },
    setAppearance(theme, saveInStore = true, dispatchEvent = true) {
      const $resetStylesEl = this._resetStylesOnLoad();

      if (saveInStore) {
        localStorage.setItem('hs_theme', theme);
      }

      if (theme === 'auto') {
        theme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'default';
      }

      document.querySelector('html').classList.remove('dark');
      document.querySelector('html').classList.remove('default');
      document.querySelector('html').classList.remove('auto');

      document
        .querySelector('html')
        .classList.add(this.getOriginalAppearance());

      setTimeout(() => {
        $resetStylesEl.remove();
      });

      if (dispatchEvent) {
        window.dispatchEvent(
          new CustomEvent('on-hs-appearance-change', { detail: theme })
        );
      }
    },
    getAppearance() {
      let theme = this.getOriginalAppearance();
      if (theme === 'auto') {
        theme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'default';
      }
      return theme;
    },
    getOriginalAppearance() {
      const defaultTheme = 'default';
      return localStorage.getItem('hs_theme') || defaultTheme;
    },
  };
  HSThemeAppearance.init();

  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (HSThemeAppearance.getOriginalAppearance() === 'auto') {
        HSThemeAppearance.setAppearance('auto', false);
      }
    });

  window.addEventListener('load', () => {
    const $clickableThemes = document.querySelectorAll(
      '[data-hs-theme-click-value]'
    );
    const $switchableThemes = document.querySelectorAll(
      '[data-hs-theme-switch]'
    );

    $clickableThemes.forEach($item => {
      $item.addEventListener('click', () =>
        HSThemeAppearance.setAppearance(
          $item.getAttribute('data-hs-theme-click-value'),
          true,
          $item
        )
      );
    });

    $switchableThemes.forEach($item => {
      $item.addEventListener('change', e => {
        HSThemeAppearance.setAppearance(e.target.checked ? 'dark' : 'default');
      });

      $item.checked = HSThemeAppearance.getAppearance() === 'dark';
    });

    window.addEventListener('on-hs-appearance-change', e => {
      $switchableThemes.forEach($item => {
        $item.checked = e.detail === 'dark';
      });
    });
  });
</script>

{/*
  Dark-hero 页面（作品集）的导航配色覆盖：
  让导航成为 Hero 同色系的深墨绿玻璃，避免浅色胶囊压住大图配色。
*/}
<style is:global>
  /* 填平浮动胶囊上方的 16px 间隙，使顶部与 Hero 连成一体 */
  [data-navbar-tone='on-dark']::before {
    content: '';
    position: absolute;
    inset: -1rem 0 auto 0;
    height: calc(100% + 1rem);
    background-color: #17231f;
    z-index: -1;
  }

  [data-navbar-tone='on-dark'] nav {
    /* 与作品集 Hero 完全同色，避免浅色胶囊压住大图配色 */
    background-color: #17231f;
    border-color: rgb(255 255 255 / 0.14);
  }

  /* 链接与按钮：浅色文字 + 荧光绿高亮 */
  [data-navbar-tone='on-dark'] nav a:not([aria-current='page']),
  [data-navbar-tone='on-dark'] nav button {
    color: rgb(255 255 255 / 0.76);
  }

  [data-navbar-tone='on-dark'] nav a:not([aria-current='page']):hover,
  [data-navbar-tone='on-dark'] nav button:hover {
    color: #fff;
    background-color: rgb(255 255 255 / 0.08);
  }

  [data-navbar-tone='on-dark'] nav a[aria-current='page'] {
    color: #d7f568;
  }

  /* 品牌 Logo：文字转白，黄色装饰块换成 Hero 的荧光绿 */
  [data-navbar-tone='on-dark'] nav svg .text-neutral-700 {
    color: #f3f6ef;
  }

  [data-navbar-tone='on-dark'] nav svg .text-yellow-500 {
    color: #d7f568;
  }

  /* 登录按钮左侧分隔线 */
  [data-navbar-tone='on-dark'] nav button[data-hs-overlay] {
    border-color: rgb(255 255 255 / 0.18);
  }

  /* 移动端展开菜单的底色 */
  [data-navbar-tone='on-dark'] nav .hs-collapse {
    color: #f3f6ef;
  }
</style>
