---
/**
 * A section heading with a rule under it and an optional trailing control
 * (filter buttons, a search box). Shared by the portfolio archive and the
 * category list so both sections open on the same baseline.
 */
interface Props {
  heading: string;
  /** Small accent line above the heading, e.g. "THE ARCHIVE". */
  eyebrow?: string;
  subTitle?: string;
}

const { heading, eyebrow, subTitle } = Astro.props;
---

<div class="flex flex-col justify-between gap-6 border-b border-neutral-400/70 pb-6 sm:flex-row sm:items-end dark:border-neutral-600">
  <div>
    {eyebrow && (
      <p class="text-sm font-semibold text-brand-rust dark:text-brand-blush">
        {eyebrow}
      </p>
    )}
    <h2
      class:list={[
        'font-serif text-3xl text-neutral-900 sm:text-4xl dark:text-neutral-100',
        eyebrow && 'mt-2',
      ]}
    >
      {heading}
    </h2>
    {subTitle && (
      <p class="mt-2 max-w-xl text-sm text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    )}
  </div>

  <slot name="action" />
</div>
