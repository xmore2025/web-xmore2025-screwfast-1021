---
import { Image } from 'astro:assets';
import Icon from '@components/ui/icons/Icon.astro';
import { formatDate } from '@utils/utils';
import type { CategorySummary } from '@utils/categories';

/**
 * Cover card for a category: the four categories that have cover art are
 * shown as image tiles in the index hero. Text-only categories never reach
 * this component — `CategoryRow` handles them.
 *
 * The whole tile is one link, and its accessible name spells out the post
 * count so a screen reader gets the same information the overlay shows.
 */
interface Props {
  summary: CategorySummary;
  /** `hero` fills a mosaic cell; `grid` keeps a 4:3 box of its own. */
  variant?: 'hero' | 'grid';
  /** Heading level, so the page outline stays valid in any section. */
  as?: 'h2' | 'h3';
}

const { summary, variant = 'hero', as: Heading = 'h3' } = Astro.props;
const { copy } = Astro.locals;
const labels = copy.categoriesIndex;
const item = labels.items[summary.id];
const cover = summary.definition.cover;

const meta = [
  labels.entryCount(summary.count),
  summary.latest
    ? labels.updated(formatDate(summary.latest, summary.locale))
    : labels.emptyCategory,
];
---

<a
  class:list={[
    'group relative flex min-w-0 flex-col justify-end overflow-hidden bg-[#263a32] ring-[#d7f568] outline-hidden focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[#17231f]',
    variant === 'hero' ? 'h-full min-h-44' : 'aspect-[4/3]',
  ]}
  href={summary.path}
  aria-label={`${item.title} — ${labels.entryCount(summary.count)}`}
  data-astro-prefetch
>
  {cover && (
    <Image
      class="absolute inset-0 size-full object-cover transition duration-700 group-hover:scale-[1.04]"
      src={cover}
      alt={item.coverAlt}
      format="avif"
      widths={[320, 480, 720, 960]}
      sizes="(min-width: 1024px) 24vw, 46vw"
      loading="eager"
      draggable={false}
    />
  )}
  <div
    class="absolute inset-0 bg-linear-to-t from-[#0d1411]/95 via-[#0d1411]/35 to-transparent"
    aria-hidden="true"
  ></div>

  <span
    class="absolute end-3 top-3 z-1 flex size-9 items-center justify-center rounded-full bg-[#d7f568] text-[#17231f] transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    aria-hidden="true"
  >
    <Icon name="arrowRight" class="size-4 -rotate-45" />
  </span>

  <div class="relative flex flex-col gap-1 p-4 sm:p-5">
    <p class="flex items-center gap-2 text-xs font-semibold text-[#d7f568]">
      <span aria-hidden="true">{summary.definition.emoji}</span>
      <span>{meta[0]}</span>
    </p>
    <Heading class="text-lg leading-tight font-bold text-white sm:text-xl">
      {item.title}
    </Heading>
    <p class="text-xs text-white/60">{meta[1]}</p>
  </div>
</a>
