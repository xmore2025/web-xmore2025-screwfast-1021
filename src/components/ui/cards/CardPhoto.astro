---
import { Image } from 'astro:assets';
import Icon from '@components/ui/icons/Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { pathFor } from '@utils/content';
import { PHOTO_CATEGORY_STYLES } from '@data/photo-categories';

/**
 * One photograph in the archive. Takes an entry and nothing else — the path
 * and the localised category name come from the content and copy modules.
 */
interface Props {
  photo: CollectionEntry<'photography'>;
}

const { photo } = Astro.props;
const { photography: labels } = Astro.locals.copy;
const category = photo.data.category;
---

<a
  class="group block break-inside-avoid rounded-xl ring-zinc-500 outline-hidden transition duration-300 focus-visible:ring-3 dark:ring-zinc-200"
  href={pathFor(photo)}
>
  <div class="relative overflow-hidden rounded-xl">
    <Image
      class="w-full rounded-xl object-cover transition duration-500 ease-in-out group-hover:scale-105"
      src={photo.data.cardImage}
      alt={photo.data.cardImageAlt}
      draggable={'false'}
      format={'avif'}
    />
    {category && (
      <span
        class={`absolute start-3 top-3 rounded-full px-3 py-1 text-xs font-medium ${PHOTO_CATEGORY_STYLES[category]}`}
      >
        {labels.categories[category]}
      </span>
    )}
  </div>

  <div class="mt-4">
    <h3 class="text-lg font-bold text-neutral-800 group-hover:text-neutral-600 dark:text-neutral-200 dark:group-hover:text-neutral-400">
      {photo.data.title}
    </h3>
    <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
      {photo.data.description}
    </p>
    {(photo.data.location || photo.data.camera) && (
      <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neutral-500 dark:text-neutral-500">
        {photo.data.location && (
          <span class="inline-flex items-center gap-1">
            <Icon name="arrowRight" class="size-3 shrink-0" />
            {photo.data.location}
          </span>
        )}
        {photo.data.camera && <span>{photo.data.camera}</span>}
      </p>
    )}
  </div>
</a>
