---
/**
 * Brand mark.
 *
 * Renders the site logo. The mark itself is a plain SVG asset so it can be
 * swapped without touching any layout: replace
 * `src/images/starlight/screwfast_logo.svg` and every usage updates.
 */
import logoMark from '@images/starlight/screwfast_logo.svg?url';

const { class: className, ...rest } = Astro.props;
---

<img
  src={logoMark}
  alt="XMore Studio"
  draggable="false"
  {...rest}
  class:list={['block shrink-0 object-contain select-none', className]}
/>
