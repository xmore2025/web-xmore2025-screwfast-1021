---
import MainLayout from '@/layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import Icon from '@components/ui/icons/Icon.astro';
import { entriesFor, pathFor } from '@utils/content';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).photographyIndex;

const photos = await entriesFor('photography', locale);

const categoryColors: Record<string, string> = {
  street: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
  portrait: 'bg-rose-100 text-rose-800 dark:bg-rose-900 dark:text-rose-200',
  landscape:
    'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  abstract:
    'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
  experiment:
    'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
};
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
>
  <section class="mx-auto max-w-[85rem] space-y-8 px-4 pt-16 sm:px-6 lg:px-8 2xl:max-w-full">
    <div class="mx-auto max-w-3xl text-left sm:text-center">
      <h1 class="block text-4xl font-bold tracking-tight text-balance text-neutral-800 md:text-5xl lg:text-6xl dark:text-neutral-200">
        {copy.heading}
      </h1>
      <p class="mt-4 text-lg text-pretty text-neutral-600 dark:text-neutral-400">
        {copy.subTitle}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    {photos.length === 0 ? (
      <p class="text-center text-neutral-600 dark:text-neutral-400">
        {copy.noPhotos}
      </p>
    ) : (
      <div class="columns-1 gap-6 sm:columns-2 lg:columns-3 [&>*]:mb-6">
        {photos.map(photo => (
          <a
            class="group block break-inside-avoid rounded-xl ring-zinc-500 outline-hidden transition duration-300 focus-visible:ring-3 dark:ring-zinc-200"
            href={pathFor(photo)}
          >
            <div class="relative overflow-hidden rounded-xl">
              <Image
                class="w-full rounded-xl object-cover transition duration-500 ease-in-out group-hover:scale-105"
                src={photo.data.cardImage}
                alt={photo.data.cardImageAlt}
                draggable={'false'}
                format={'avif'}
              />
              {photo.data.category && (
                <span
                  class={`absolute start-3 top-3 rounded-full px-3 py-1 text-xs font-medium ${categoryColors[photo.data.category] ?? ''}`}
                >
                  {photo.data.category}
                </span>
              )}
            </div>
            <div class="mt-4">
              <h3 class="text-lg font-bold text-neutral-800 group-hover:text-neutral-600 dark:text-neutral-200 dark:group-hover:text-neutral-400">
                {photo.data.title}
              </h3>
              <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
                {photo.data.description}
              </p>
              {(photo.data.location || photo.data.camera) && (
                <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neutral-500 dark:text-neutral-500">
                  {photo.data.location && (
                    <span class="inline-flex items-center gap-1">
                      <Icon name="arrowRight" class="size-3 shrink-0" />
                      {photo.data.location}
                    </span>
                  )}
                  {photo.data.camera && <span>{photo.data.camera}</span>}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</MainLayout>
