---
import MainLayout from '@/layouts/MainLayout.astro';
import PageHeader from '@components/ui/blocks/PageHeader.astro';
import EmptyState from '@components/ui/blocks/EmptyState.astro';
import CardPhoto from '@components/ui/cards/CardPhoto.astro';
import { entriesFor, pathFor } from '@utils/content';
import { absoluteUrl } from '@utils/metadata';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

/**
 * The photography archive in one locale: a header, then a masonry of the
 * photos. Everything that used to be hand-rolled here — the header, the
 * empty state, the card — is a component now.
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.photographyIndex;
const photos = await entriesFor('photography', locale);
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
  section={t.photography.ogSection}
  kind={{
    type: 'CollectionPage',
    items: photos.map(photo => ({
      name: photo.data.title,
      url: absoluteUrl(pathFor(photo)),
    })),
  }}
>
  <PageHeader heading={copy.heading} subTitle={copy.subTitle} />

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    {photos.length === 0 ? (
      <EmptyState message={copy.noPhotos} />
    ) : (
      <div class="columns-1 gap-6 sm:columns-2 lg:columns-3 [&>*]:mb-6">
        {photos.map(photo => (
          <CardPhoto photo={photo} />
        ))}
      </div>
    )}
  </section>
</MainLayout>
