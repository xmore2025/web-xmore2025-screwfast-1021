---
import MainLayout from '@/layouts/MainLayout.astro';
import CtaPanel from '@components/ui/blocks/CtaPanel.astro';
import SectionIntro from '@components/ui/blocks/SectionIntro.astro';
import CardPhoto from '@components/ui/cards/CardPhoto.astro';
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { entriesFor, localeOf } from '@utils/content';
import { formatDate } from '@utils/utils';
import { localePath } from '@utils/locale';
import { PHOTO_CATEGORY_STYLES } from '@data/photo-categories';
import { getCopy } from '@/copy';

/**
 * One photograph. The locale is the entry's own.
 *
 * Same shape as a blog post — breadcrumb, meta line, serif title, standfirst,
 * full-bleed cover, prose, then a way onward — so reading across collections
 * does not mean relearning the page.
 */
interface Props {
  photo: CollectionEntry<'photography'>;
}

const { photo } = Astro.props;
const locale = localeOf(photo);
const t = getCopy(locale);
const labels = t.photography;
const { Content } = await render(photo);

/** The rest of the archive, so the page is not a dead end. */
const otherPhotos = (await entriesFor('photography', locale))
  .filter(entry => entry.id !== photo.id)
  .slice(0, 3);

const category = photo.data.category;

const meta = [
  photo.data.location && { label: labels.location, value: photo.data.location },
  photo.data.camera && { label: labels.camera, value: photo.data.camera },
  photo.data.shootDate && {
    label: labels.shotOn,
    value: formatDate(photo.data.shootDate, locale),
  },
].filter(Boolean) as { label: string; value: string }[];
---

<MainLayout
  title={photo.data.title}
  description={photo.data.description}
  section={labels.ogSection}
  kind={{ type: 'Article', image: photo.data.cardImage.src }}
>
  <section class="mx-auto max-w-[85rem] px-4 pt-6 sm:px-6 lg:px-8 lg:pt-10 2xl:max-w-full">
    <div class="mx-auto max-w-[46rem] lg:max-w-[48rem] xl:max-w-[50rem]">
      <nav aria-label="Breadcrumb" class="text-xs text-neutral-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a
              class="transition hover:text-brand-rust dark:hover:text-brand-blush"
              href={localePath(locale)}
            >
              {labels.breadcrumbHome}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a
              class="transition hover:text-brand-rust dark:hover:text-brand-blush"
              href={localePath(locale, '/photography')}
            >
              {labels.breadcrumbPhotography}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li
            class="max-w-[14rem] truncate text-neutral-700 sm:max-w-md dark:text-neutral-300"
            aria-current="page"
          >
            {photo.data.title}
          </li>
        </ol>
      </nav>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        {category && (
          <span
            class={`rounded-full px-3 py-1 text-xs font-medium ${PHOTO_CATEGORY_STYLES[category]}`}
          >
            {labels.categories[category]}
          </span>
        )}
        {photo.data.shootDate && (
          <time
            class="text-xs font-semibold tracking-[0.16em] text-brand-rust uppercase dark:text-brand-blush"
            datetime={photo.data.shootDate.toISOString()}
          >
            {formatDate(photo.data.shootDate, locale)}
          </time>
        )}
      </div>

      <h1 class="mt-5 font-serif text-3xl leading-[1.12] text-balance text-neutral-900 sm:text-4xl lg:text-5xl xl:text-6xl dark:text-neutral-100">
        {photo.data.title}
      </h1>

      <p class="mt-5 text-base text-pretty text-neutral-600 sm:text-lg sm:leading-8 dark:text-neutral-400">
        {photo.data.description}
      </p>
    </div>
  </section>

  <section class="mx-auto mt-10 max-w-[85rem] px-4 sm:px-6 lg:mt-14 lg:px-8 2xl:max-w-full">
    <Image
      class="aspect-[4/3] w-full object-cover sm:aspect-[16/9] lg:aspect-[21/9]"
      src={photo.data.cardImage}
      alt={photo.data.cardImageAlt}
      format="avif"
      widths={[480, 768, 1000, 1200]}
      sizes="(min-width: 1360px) 1360px, 100vw"
      loading="eager"
      draggable={false}
    />
  </section>

  <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16 2xl:max-w-full">
    <div class="mx-auto max-w-[46rem] lg:max-w-[48rem] xl:max-w-[50rem]">
      <article class="prose prose-base prose-neutral sm:prose-lg dark:prose-invert max-w-none text-pretty prose-headings:font-serif prose-headings:font-normal prose-headings:tracking-tight prose-h2:mt-12 prose-h2:mb-4 prose-h2:text-2xl sm:prose-h2:text-3xl prose-p:leading-7 sm:prose-p:leading-8 prose-a:text-brand-rust prose-a:underline-offset-4 dark:prose-headings:text-neutral-100 dark:prose-a:text-brand-blush prose-blockquote:border-s-2 prose-blockquote:border-brand-citrus prose-blockquote:ps-5 prose-blockquote:not-italic prose-blockquote:text-neutral-600 dark:prose-blockquote:text-neutral-400 prose-li:leading-7 sm:prose-li:leading-8">
        <Content />
      </article>

      {meta.length > 0 && (
        <dl class="mt-12 border-t border-neutral-300/80 pt-8 dark:border-neutral-700">
          {meta.map(item => (
            <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 border-b border-neutral-200 py-3 text-sm last:border-b-0 dark:border-neutral-800">
              <dt class="text-neutral-500">{item.label}</dt>
              <dd class="text-neutral-800 dark:text-neutral-200">
                {item.value}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </section>

  {otherPhotos.length > 0 && (
    <section class="mx-auto max-w-[85rem] px-4 pb-16 sm:px-6 lg:px-8 2xl:max-w-full">
      <div class="border-t border-neutral-300/80 pt-10 dark:border-neutral-700">
        <SectionIntro heading={labels.morePhotos} />
        <div class="columns-1 gap-6 sm:columns-2 lg:columns-3 [&>*]:mb-6">
          {otherPhotos.map(entry => (
            <CardPhoto photo={entry} />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaPanel
    title={t.photographyIndex.heading}
    body={t.photographyIndex.subTitle}
    action={{
      label: labels.backToArchive,
      href: localePath(locale, '/photography'),
    }}
  />
</MainLayout>
