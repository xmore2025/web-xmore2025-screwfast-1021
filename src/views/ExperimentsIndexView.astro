---
import MainLayout from '@/layouts/MainLayout.astro';
import PageHeader from '@components/ui/blocks/PageHeader.astro';
import EmptyState from '@components/ui/blocks/EmptyState.astro';
import CardExperiment from '@components/ui/cards/CardExperiment.astro';
import { entriesFor, pathFor } from '@utils/content';
import { absoluteUrl } from '@utils/metadata';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

/**
 * The experiment archive in one locale: a header, then a grid of the
 * experiments. Same shape as the photography archive, so the two read as one
 * site rather than two pages that happen to sit next to each other.
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.experimentsIndex;
const experiments = await entriesFor('experiments', locale);
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
  section={t.experiments.ogSection}
  kind={{
    type: 'CollectionPage',
    items: experiments.map(experiment => ({
      name: experiment.data.title,
      url: absoluteUrl(pathFor(experiment)),
    })),
  }}
>
  <PageHeader heading={copy.heading} subTitle={copy.subTitle} />

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    {experiments.length === 0 ? (
      <EmptyState message={copy.noExperiments} />
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {experiments.map(experiment => (
          <CardExperiment experiment={experiment} />
        ))}
      </div>
    )}
  </section>
</MainLayout>
