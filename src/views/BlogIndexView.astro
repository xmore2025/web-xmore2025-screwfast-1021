---
import MainLayout from '@/layouts/MainLayout.astro';
import PageHeader from '@components/ui/blocks/PageHeader.astro';
import SectionIntro from '@components/ui/blocks/SectionIntro.astro';
import EmptyState from '@components/ui/blocks/EmptyState.astro';
import CardBlog from '@components/ui/cards/CardBlog.astro';
import CardBlogRecent from '@components/ui/cards/CardBlogRecent.astro';
import CardInsight from '@components/ui/cards/CardInsight.astro';
import { entriesFor, pathFor } from '@utils/content';
import { absoluteUrl } from '@utils/metadata';
import { localePath, type MarketingLocale } from '@utils/locale';
import { getCopy } from '@/copy';

/** The blog index (posts + insights) in one locale. */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.blogIndex;

const blogPosts = await entriesFor('blog', locale);
const insightPosts = await entriesFor('insights', locale);

// Separate the most recent post from others
const [mostRecentPost, ...otherPosts] = blogPosts;
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
  section={t.blog.ogSection}
  kind={{
    type: 'CollectionPage',
    items: blogPosts.map(post => ({
      name: post.data.title,
      url: absoluteUrl(pathFor(post)),
    })),
  }}
>
  <PageHeader
    heading={copy.heading}
    subTitle={copy.subTitle}
    action={{
      label: copy.browseCategories,
      href: localePath(locale, '/categories'),
    }}
  />

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    {blogPosts.length === 0 ? (
      <EmptyState message={copy.noPosts} />
    ) : (
      <div class="grid gap-6 lg:grid-cols-2">
        {otherPosts.map(blogEntry => (
          <CardBlog blogEntry={blogEntry} />
        ))}
      </div>
    )}
  </section>

  {/* Most recent blog post */}
  {mostRecentPost && (
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
      <CardBlogRecent blogEntry={mostRecentPost} />
    </section>
  )}

  {/* Insights section */}
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <SectionIntro
      heading={copy.insightsHeading}
      subTitle={copy.insightsSubTitle}
    />
    {insightPosts.length === 0 ? (
      <EmptyState message={copy.noInsights} />
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {insightPosts.map(insightEntry => (
          <CardInsight insightEntry={insightEntry} />
        ))}
      </div>
    )}
  </section>
</MainLayout>
