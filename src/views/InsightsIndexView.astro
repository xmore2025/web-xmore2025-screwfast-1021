---
import MainLayout from '@/layouts/MainLayout.astro';
import PageHeader from '@components/ui/blocks/PageHeader.astro';
import EmptyState from '@components/ui/blocks/EmptyState.astro';
import CardInsight from '@components/ui/cards/CardInsight.astro';
import { entriesFor, pathFor } from '@utils/content';
import { absoluteUrl } from '@utils/metadata';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

/** The insights archive in one locale. */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.insightsIndex;

const insights = await entriesFor('insights', locale);
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
  section={t.insights.ogSection}
  kind={{
    type: 'CollectionPage',
    items: insights.map(insight => ({
      name: insight.data.title,
      url: absoluteUrl(pathFor(insight)),
    })),
  }}
>
  <PageHeader heading={copy.heading} subTitle={copy.subTitle} />

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    {insights.length === 0 ? (
      <EmptyState message={copy.noInsights} />
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {insights.map(insightEntry => (
          <CardInsight insightEntry={insightEntry} />
        ))}
      </div>
    )}
  </section>
</MainLayout>
